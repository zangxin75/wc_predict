# ---------------------------------------------------------------------------
# Environment variables template — copy to .env and fill in real values.
#   cp .env.example .env
#
# DO NOT commit the real .env file. .gitignore already excludes it.
# Treat keys as production secrets: chmod 600 .env on the deployment host.
# ---------------------------------------------------------------------------

# Stripe LIVE keys — production real-money transactions
# Dashboard: https://dashboard.stripe.com/apikeys
# Live keys start with sk_live_ / pk_live_ (NOT sk_test_ / pk_test_)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Stripe webhook signing secret — verifies event payloads
# Create at: Dashboard → Developers → Webhooks → Add endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Zhipu GLM-4 API key — for i18n translation / web search intelligence
# Console: https://open.bigmodel.cn/
GLM_API_KEY=xxx

# LiteLLM proxy master key — for lessons_fetcher / generate_lessons / scan_2026_misses
LITELLM_MASTER_KEY=sk-litellm-master-key

# Session cookie signing secret — for starlette SessionMiddleware
# MUST be a cryptographically random string of >= 32 bytes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, webapp falls back to deriving from STRIPE_SECRET_KEY (with warning).
SESSION_SECRET=please_generate_32_plus_chars_random_string_here
