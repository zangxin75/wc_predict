# Python 字节码与缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 备份文件
*.bak
odds_wc.csv.bak*

# 根目录临时研究/分析脚本(单次产出,不进仓库)
/_*.py
/_*.html
/_*.csv

# 抓取缓存(可由 fetch_wc2026.py 重新生成)
.wc2026_cache.json

# webapp 运行时缓存(webapp/cache.py 启动时自动重建 elo/schedule/groups)
webapp/data/cache.json

# 运行时缓存(LLM/智谱/i18n 翻译缓存,可由脚本重建)
data/i18n_cache/
data/match_i18n_cache/

# Python 虚拟环境
.venv/
venv/

# Claude Code 本地配置(与他人无关)
.claude/

# OMC 运行时状态
.omc/

# 编辑器/系统杂项
.vscode/
.idea/
.DS_Store
Thumbs.db

# webapp 临时验证/调试产物(不进仓库)
webapp/_verify*.py
webapp/_mobile_probe.py
webapp/_shot.py
webapp/_shots/
